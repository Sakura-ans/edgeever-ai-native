{
  "name": "edgeever-mind",
  "version": "1.119.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/shared"
  ],
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun scripts/prepare-mind-assets.mjs && vite --config apps/web/vite.config.ts --host 127.0.0.1 --port 5173",
    "dev:desktop": "bun run --cwd apps/desktop dev:mind",
    "test": "bun test apps packages scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "bun scripts/prepare-mind-assets.mjs && vite build --config apps/web/vite.config.ts",
    "build:desktop": "bun run build:web && bun run --cwd apps/desktop dist:mind"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
